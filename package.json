{
  "name": "phrase-manager",
  "version": "1.0.5",
  "private": true,
  "scripts": {
    "dev": "webpack -w --mode development",
    "build": "webpack --mode production",
    "clean": "node scripts/clean.cjs",
    "verify-locales": "node scripts/verify-locales.cjs",
    "verify-release": "node scripts/verify-release.cjs",
    "release:build": "npm run clean && npm run verify-locales && npm run build && npm run verify-release"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.1.1",
