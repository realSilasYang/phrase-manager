    "canvas-confetti": "^1.9.4",
    "iconv-lite": "^0.7.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "roughjs": "^4.6.6"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "babel-loader": "^10.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.2",
    "less": "^4.4.2",
    "less-loader": "^12.3.0",
    "style-loader": "^4.0.0",
    "webpack": "^5.102.1",
